# Required: Mistral API Key for Title, Summary, Extraction, and RAG Chat
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Sarvam AI API Key for Hindi / Hinglish Speech-to-Text
SARVAM_API_KEY=your_sarvam_api_key_here

# Whisper Model (tiny, base, small, medium, large) - default is small
WHISPER_MODEL=small
